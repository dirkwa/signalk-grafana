{
  "name": "signalk-grafana",
  "version": "1.2.4",
  "description": "Managed Grafana with auto-provisioned QuestDB dashboards for Signal K",
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-plugin-configurator"
  ],
  "signalk": {
    "displayName": "Grafana Dashboards",
    "appIcon": "./icon.svg",
    "requires": [
      "signalk-container",
      "signalk-questdb"
    ],
    "screenshots": [
      "./docs/screenshot/signalk_grafana_1.png",
      "./docs/screenshot/signalk_grafana_2.png"
    ]
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && webpack",
    "build:config": "webpack",
    "watch": "tsc --watch",
    "prettier": "prettier --write .",
    "lint": "eslint --fix",
    "format": "npm run prettier && npm run lint",
    "ci-lint": "eslint && prettier --check .",
    "test": "node --test 'dist/test/**/*.test.js'",
    "build:all": "npm run build && npm test",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "author": "Dirk Wahrheit <dirkwahrheit@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dirkwa/signalk-grafana"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "^10.0.1",
    "@signalk/server-api": "latest",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.18",
    "babel-loader": "^10.1.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.0",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2"
  }
}
